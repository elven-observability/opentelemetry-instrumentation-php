<?xml version="1.0"?>
<ruleset name="Elven Observability PHP">
  <description>PSR-12 coding standard for the Elven PHP observability package.</description>
  <rule ref="PSR12">
    <exclude name="Generic.Files.LineLength"/>
  </rule>
  <file>src</file>
  <file>tests</file>
  <file>examples</file>
  <exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
